# Copia este archivo como .streamlit/secrets.toml para probar en tu computador.
# En Streamlit Cloud se configura en Settings → Secrets (no se sube a GitHub).
DEEPSEEK_API_KEY = "sk-..."

# Clave de la zona del profesor (si no se define, es 2209).
CLAVE_PROFESOR = "2209"

# Opcional: permite que "Guardar vocabulario" escriba directamente en el repositorio.
# Token de GitHub (fine-grained) con permiso "Contents: Read and write" solo sobre este repo.
# GITHUB_TOKEN = "github_pat_..."
# GITHUB_REPO = "kaezar22/mandarin_asistant"
